@model ErrorViewModel
@{
    ViewData["Title"] = "Oops! Something went wrong";
    bool isDevelopment = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development";
}

<div class="container text-center mt-5">
    <h1 class="text-danger">Oops! Something went wrong.</h1>
    <h4>We apologize for the inconvenience.</h4>
    
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }

    @if (isDevelopment)
    {
        <div class="alert alert-warning mt-3">
            <h5>Technical Details (Development Mode Only)</h5>
            <p>
                The application encountered an error. If you're a developer, check the logs for more details.
            </p>
            <p><strong>Request ID:</strong> @Model.RequestId</p>
        </div>
    }

    <div class="mt-4">
        <a href="/" class="btn btn-primary" style="background-color: #C0392B;">Go Back to Home</a>
        <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
    </div>
</div>
