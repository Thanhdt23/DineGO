@using Microsoft.AspNetCore.Http;

<div class="header-wrapper container">
  <nav class="navbar navbar-expand-lg">
    <div class="container-fluid">
      <a asp-controller="Home" asp-action="Index" class="logo-text">DineGO</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll"
        aria-controls="navbarScroll" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarScroll">
        <ul class="navbar-nav me-auto my-2 my-lg-0 navbar-nav-scroll" style="--bs-scroll-height: 100px;">

          <li class="nav-item">
            <a class="nav-link" asp-controller="Restaurant" asp-action="Search">Nhà hàng gần bạn</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#">Nhà hàng uy tín</a>
          </li>
          </li class="nav-item">
          <a class="nav-link" asp-controller="Blog" asp-action="Index">Tin tức và blog</a>
          </li>
          </li class="nav-item">
          <a class="nav-link" href="#">Báo cáo</a>
          </li>
        </ul>
        @{
          var cusId = Context.Session.GetInt32("cus_id");
        }
        <div class="profile-container" id="profileContainer">
          <div class="profile-name">
            @if (cusId.HasValue)
            {
              <span>👤 @cusId</span>
              <div class="profile-dropdown" id="profileMenu">
                <a asp-controller="Customer" asp-action="Profile">Thông tin tài khoản</a>
                <a href="#">Quản lý mật khẩu</a>
                <a href="#">Lịch sử đặt chỗ</a>
                <a class="logout-btn btn-danger" asp-controller="Auth" asp-action="Logout">Đăng xuất</a>
              </div>
            }
            else
            {
              <span class="guest-text" onclick="location.href='@Url.Action("Login", "Auth")'">👤 Đăng nhập</span>
            }
          </div>
        </div>
      </div>
    </div>
</nav>
<form asp-controller="Restaurant" asp-action="Search" method="get" class="row g-2">
  <div class="col-12 col-md-1">
    <select name="address" class="form-select">
      <option value="">Tất Cả</option>
      <option value="Cần Thơ">Cần Thơ</option>
      <option value="Bạc Liêu">Bạc Liêu</option>
      <option value="Cà Mau">Cà Mau</option>
      <option value="Hậu Giang">Hậu Giang</option>
      <option value="Tiền Giang">Tiền Giang</option>
    </select>
  </div>
  <div class="col-12 col-md-8">
    <input type="text" name="name" class="form-control" placeholder="Bạn muốn đặt chỗ đến đâu">
  </div>
  <div class="col-12 col-md-1">
    <button type="submit" class="btn w-100" style="background-color: #C0392B; color: white; border: none;">
      <i class="bi bi-search"></i> Tìm kiếm
    </button>
  </div>
  <div class="col-12 col-md-2 text-center">
    <i class="bi bi-telephone-fill" style="color: #C0392B; font-size: 24px;"></i>
    <span style="font-weight: bold; font-size: 20px; color: #C0392B;">1900 6005</span>
    </span>
  </div>
</form>
</div>