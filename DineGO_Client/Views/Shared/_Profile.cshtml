@model DineGO_Client.Models.Custom.CustomProfileViewModel
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DineGO_Client</title>
    <link rel="icon" type="image/png" href="/common/images/favicon.ico" />
    <link rel="stylesheet" href="/common/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="/common/lib/slider/owl.carousel.min.css" />
    <link rel="stylesheet" href="/common/lib/slider/owl.theme.default.min.css" />
    <link rel="stylesheet" href="/common/css/popup.css" />
    <link rel="stylesheet" href="/client/css/site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

</head>

<body>

    <header>
        @Html.Partial("_Header")
    </header>
    @Html.Partial("_PopupForm")
    <main role="main" class="pb-3">
        <div class="container mt-5">
            <div class="row container-profile">
                <!-- Sidebar (Chiếm 4 cột) -->
                <div class="col-md-4">
                    <div class="sidebar">
                        <div class="profile-info" onclick="toggleDropdown()">
                            <div class="profile-avatar">
                                <img src="/client/images/@Model.Customer.cus_image" alt="Avatar">
                            </div>
                            <h3 class="profile-username">@Model.Customer.cus_name</h3>
                            <div class="profile-icon">
                                <i class="fas fa-chevron-down dropdown-arrow">
                                </i>
                                <!-- Dropdown Menu -->
                                <div class="list-profile-dropdown" id="profileDropdown">
                                    @foreach (var restaurantOwner in Model.RestaurantOwners)
                                    {
                                        var displayName = restaurantOwner.resOwner_name;
                                        if(!string.IsNullOrEmpty(displayName) && displayName.Length > 10)
                                        {
                                            displayName = displayName.Substring(0, 10) + "...";
                                        }
                                        <div class="menu-item">
                                            <a href="@Url.Action("Index", "RestaurantOwner", new { Id = restaurantOwner.resOwner_id })" style="text-decoration:none; color:inherit;">
                                                <i class="fas fa-user"></i> @displayName
                                                <i class="fas fa-sign-out-alt"></i>
                                            </a>
                                        </div>
                                    }
                                    <div class="menu-item open-dynamic-modal" data-title="Nhập thông tin chủ nhà hàng"
                                        data-fields="Name" data-action="Create" data-controller="RestaurantOwner" data-method="POST">
                                        <i class="fas fa-plus"></i> Create
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr>
                        <div class="menu-item" onclick="location.href='@Url.Action("Profile", "Customer")'">Profile
                        </div>
                        <div class="menu-item" onclick="location.href='@Url.Action("Login", "Auth")'">Order History
                        </div>
                        <div class="menu-item">Payment History</div>
                        <div class="menu-item">Settings</div>
                        <div class="menu-item" onclick="location.href='@Url.Action("Logout", "Auth")'">Logout</div>
                    </div>
                </div>
                @RenderBody()
            </div>
        </div>
    </main>

    <footer>
        @Html.Partial("_Footer")
    </footer>

    <script src="/common/js/popup.js"></script>
    <script src="/common/lib/jquery/jquery-3.6.0.min.js"></script>
    <script src="/common/lib/bootstrap/bootstrap.min.js"></script>
    <script src="/common/lib/slider/owl.carousel.min.js"></script>
    <script src="/client/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
