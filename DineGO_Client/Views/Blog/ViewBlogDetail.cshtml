@model DineGO_Client.Model.Blog

@{
    ViewData["Title"] = Model?.blog_title ?? "Không có dữ liệu";
    string defaultImage = "https://storage.googleapis.com/a1aa/image/Ro3xNxdYoS1VIFlm3jZvR__ygEMTBN2cPDfSwWOTqtg.jpg";
    string imageUrl = string.IsNullOrEmpty(Model?.blog_image) ? defaultImage : Model.blog_image;
}

<div class="container all-container">
    <div class="row">
        <!-- Nội dung chính -->
        <div class="col-lg-8">
            <div class="blog-container">
                <div class="blog-section">
                    <h3>@Model?.blog_title</h3>
                    <p><strong>Ngày đăng:</strong> @Model?.blog_date.ToString("dd/MM/yyyy")</p>
                    <img src="@imageUrl" alt="Blog Image">
                    <p>@Model?.blog_information</p>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="blog-container">
                <h3>Blog mới</h3>
                <div class="blog-item mt-4">
                    <img src="https://storage.googleapis.com/a1aa/image/jyZGnwMle-G8xxriJzKkW3pn_15sh4dKAE8cM8iAauI.jpg" alt="Marketing">
                    <div class="blog-content">
                        <h3>Tăng doanh thu nhà hàng</h3>
                        <p>15/01/2025</p>
                        <p>25+ chiến lược marketing đỉnh cao...</p>
                    </div>
                </div>
                <div class="blog-item">
                    <img src="https://storage.googleapis.com/a1aa/image/NsAYbrGgbAnf4eynZgHAN2vqXGsQn10K_u6-uujH6L0.jpg" alt="Thực đơn">
                    <div class="blog-content">
                        <h3>Thực đơn hàng ngày đầy đủ dinh dưỡng</h3>
                        <p>19/12/2024</p>
                        <p>Có ảnh minh họa...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <hr>
</div>
