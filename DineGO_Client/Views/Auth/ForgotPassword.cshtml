@{
    ViewData["Title"] = "ForgotPassword";
}
<div class="login-background">
    <div class="login-container">
        <div class="login-block">
            <h4 class="login-header text-center">QUÊN MẬT KHẨU</h4>
            @if (!string.IsNullOrEmpty(ViewBag.Message))
            {
                <div class="alert alert-info text-center">@ViewBag.Message</div>
            }
            <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
                <div class="form-group">
                    <input type="email" id="email" name="email" required placeholder="Nhập email của bạn" />
                </div>
                <button type="submit" class="btn btn-primary btn-block">Gửi yêu cầu</button>
                <div class="login-footer text-center">
                    <a asp-controller="Auth" asp-action="Login">Quay lại đăng nhập</a>
                </div>
            </form>
        </div>
    </div>
</div>