@{
    ViewData["Title"] = "Booking";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
<div class="container">
    <div class="booking-container">
        <h3 class="text-center">Đặt chỗ đến @Model.res_name</h3>

        <div class="row">
            <!-- Form Đặt Chỗ -->
            <div class="col-md">
                <h5>Thông tin người đặt</h5>
                <form id="reservationForm" action="/Reservation/CreateReservation" method="post">
                    <input type="hidden" name="res_id" value="@Model.res_id">
                    <div class="col-md">
                        <div class="booking-container p-3 border rounded shadow bg-white">
                            <h5 class="fw-bold text-center">Đặt chỗ <span class="text-muted">(Để có chỗ trước khi
                                    đến)</span></h5>
                            <!-- Chọn số lượng -->
                            <div class="mb-3">
                                <label class="fw-bold"><i class="fas fa-user"></i> Người lớn:</label>
                                <select class="form-select" name="reser_quantity">
                                    <option value="1">1</option>
                                    <option value="2" selected>2</option>
                                    <option value="3">3</option>
                                    <option value="4">4</option>
                                    <option value="5">5+</option>
                                </select>
                            </div>
                            <!-- Chọn ngày và giờ -->
                            <div class="mb-3">
                                <label class="fw-bold"><i class="fas fa-clock"></i> Thời gian đến</label>
                                <div class="d-flex">
                                    <input type="date" class="form-control me-2" name="reser_date_date" required>
                                    <input type="time" class="form-control" name="reser_date_time" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Ghi chú</label>
                                <textarea class="form-control" name="reser_note" placeholder="Nhập ghi chú"></textarea>
                            </div>
                            <p class="text-danger text-center fw-bold">Đặt bàn giữ chỗ</p>
                        </div>
                    </div>
                    <hr>
                    <button type="submit" class="btn btn-danger w-100">Xác nhận đặt chỗ</button>
                </form>
            </div>
        </div>
    </div>
</div>
