<div class="container mt-4">
    <div class="row">
        <!-- Cột chứa thông tin nhà hàng (bên trái) -->
        <div class="col-md-8">
            <ul class="nav nav-tabs" id="restaurantTabs">
                <li class="nav-item">
                    <a class="nav-link active" id="proposal-tab" data-bs-toggle="tab" href="#proposal">Thông tin</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="summary-tab" data-bs-toggle="tab" href="#summary">Lịch sử đặt bàn</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="pricing-tab" data-bs-toggle="tab" href="#pricing">Đặt bàn</a>
                </li>
            </ul>

            <div class="tab-content mt-3">
                <div class="tab-pane fade show active" id="proposal">
                    <!-- Profile Content (Chiếm 8 cột) -->
                    <div class="col-md-8 d-flex justify-content-center">
                        <div class="profile-container_form">
                            <form method="post" asp-action="UpdateProfileRestaurant" asp-controller="RestaurantOwner"
                                enctype="multipart/form-data">

                                <input type="hidden" name="res_id" value="@ViewBag?.res_id" />
                                <input type="hidden" name="cate_id" value="@ViewBag?.cate_id" />
                                <input type="hidden" name="resOwner_id" value="@ViewBag?.resOwner_id" />

                                <!-- Hiển thị ảnh nhà hàng -->
                                @* <div class="profile-pic">
                                    <img src="/client/images/@(ViewBag?.res_images?.FirstOrDefault() ?? "res1.jpeg")"
                                        alt="Restaurant Image" id="restaurantImage"
                                        style="width: 200px; height: 150px; border-radius: 10px;">
                                    <input type="file" name="imageFile" class="form-control mt-2">
                                    <input type="hidden" name="res_images"
                                        value="@string.Join(",", Model?.res_images ?? new List<string>())" />
                                </div> *@

                                <div class="form-group">
                                    <label>Restaurant Name</label>
                                    <input type="text" name="res_name" class="form-control" value="@ViewBag?.res_name"
                                        required>
                                </div>

                                <div class="form-group">
                                    <label>Address</label>
                                    <input type="text" name="res_address" class="form-control"
                                        value="@ViewBag?.res_address">
                                </div>

                                <div class="form-group">
                                    <label>Phone</label>
                                    <input type="tel" name="res_phone" class="form-control" value="@ViewBag?.res_phone">
                                </div>

                                <div class="form-group">
                                    <label>Information</label>
                                    <textarea name="res_information"
                                        class="form-control">@ViewBag?.res_information</textarea>
                                </div>

                                <div class="form-group">
                                    <label>Rating</label>
                                    <input type="number" name="res_rate" class="form-control" value="@ViewBag?.res_rate"
                                        step="0.1" min="0" max="5">
                                </div>

                                <div class="form-group">
                                    <label>Average Price</label>
                                    <input type="number" name="res_price" class="form-control" value="@ViewBag?.res_price"
                                        step="0.01">
                                </div>

                                <div class="form-group">
                                    <label>Discount</label>
                                    <input type="number" name="res_discount" class="form-control"
                                        value="@ViewBag?.res_discount" step="0.01" min="0">
                                </div>

                                <div class="form-group text-center mt-3">
                                    <button type="submit" class="btn btn-primary"
                                        style="background-color: #C0392B; color: white; border: none;">
                                        Update Restaurant
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>