@model DineGO_Client.Models.Custom.CustomProfileViewModel
@{
    Layout = "../../Views/Shared/_Profile.cshtml";
    ViewData["Title"] = "Đổi Mật Khẩu";
}

<!-- Profile Content (Chiếm 8 cột) -->
<div class="col-md-8 d-flex justify-content-center">
    <div class="profile-container_form">
        <h3 class="text-center mb-4">Đổi Mật Khẩu</h3>

        <!-- Hiển thị thông báo lỗi hoặc thành công -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>
            TempData.Keep("SuccessMessage");
            TempData.Remove("SuccessMessage");
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger text-center">@TempData["ErrorMessage"]</div>
            TempData.Keep("ErrorMessage");
            TempData.Remove("ErrorMessage");
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger text-center">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <!-- Form Đổi Mật Khẩu -->
        <form asp-action="ChangePassword" method="post" class="p-4 border rounded shadow-sm bg-white">
            <div class="form-group mb-3">
                <label for="CurrentPassword" class="font-weight-bold">Mật khẩu hiện tại</label>
                <input type="password" class="form-control form-control-lg" name="CurrentPassword"
                    placeholder="Nhập mật khẩu hiện tại" required />
            </div>

            <div class="form-group mb-3">
                <label for="NewPassword" class="font-weight-bold">Mật khẩu mới</label>
                <input type="password" class="form-control form-control-lg" name="NewPassword"
                    placeholder="Nhập mật khẩu mới" required />
            </div>

            <div class="form-group mb-3">
                <label for="ConfirmNewPassword" class="font-weight-bold">Xác nhận mật khẩu mới</label>
                <input type="password" class="form-control form-control-lg" name="ConfirmNewPassword"
                    placeholder="Nhập lại mật khẩu mới" required />
            </div>

            <button type="submit" class="btn btn-danger btn-lg w-100 mt-3">Đổi mật khẩu</button>
        </form>
    </div>
</div>