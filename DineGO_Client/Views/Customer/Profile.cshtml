@{
    Layout = "../../Views/Shared/_Profile.cshtml";
}
<!-- Profile Content (Chiếm 8 cột) -->
<div class="col-md-8 d-flex justify-content-center">
    <div class="profile-container_form">
        <form method="post" asp-action="UpdateProfile" asp-controller="Customer" enctype="multipart/form-data">
            <input type="hidden" name="cus_id" value="@Model.cus_id" />
            <input type="hidden" name="cus_username" value="@Model.cus_username" />
            <input type="hidden" name="cus_password" value="@Model.cus_password" />

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <!-- Ảnh đại diện -->
            <div class="profile-pic">
                <img src="/client/images/@Model.cus_image" alt="Profile Picture" id="profileImage"
                    style="width: 150px; height: 150px; border-radius: 50%;">
                <input type="file" name="imageFile" class="form-control mt-2">
            </div>

            <div class="form-group">
                <label>Full name</label>
                <input type="text" name="cus_name" class="form-control" value="@Model.cus_name" required>
            </div>

            <div class="form-group">
                <label>Gender</label>
                <input type="text" name="cus_gender" class="form-control" value="@Model.cus_gender">
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email" name="cus_email" class="form-control" value="@Model.cus_email" required>
            </div>

            <div class="form-group">
                <label>Phone</label>
                <input type="tel" name="cus_phone" class="form-control" value="@Model.cus_phone">
            </div>

            <div class="form-group">
                <label>Address</label>
                <input type="text" name="cus_address" class="form-control" value="@Model.cus_address">
            </div>

            <div class="form-group">
                <label>Birthday</label>
                <input type="date" name="cus_birthday" class="form-control"
                    value="@Model.cus_birthday.ToString("yyyy-MM-dd")">
            </div>

            <div class="form-group text-center mt-3">
                <button type="submit" class="btn btn-primary"
                    style="background-color: #C0392B; color: white; border: none;">Cập nhật</button>
            </div>
        </form>
    </div>
</div>