@model DineGO_Client.Models.Custom.CustomProfileViewModel
@{
    Layout = "../../Views/Shared/_Profile.cshtml";
    ViewData["Title"] = "PaymentHistory";
}

<!-- Profile Content (Chiếm 8 cột) -->
<div class="col-md-8 d-flex justify-content-center">
    <div class="profile-container_form">
        <h3 class="text-center mb-4">Lịch sử thanh toán</h3>

        @if (Model.Data.ContainsKey("Payments"))
        {
            var payments = Model.Data["Payments"] as List<DineGO_Client.Model.Payment>;

            if (payments == null || !payments.Any())
            {
                <div class="alert alert-info text-center">Bạn chưa có giao dịch thanh toán nào.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered text-center">
                        <thead class="table-dark">
                            <tr>
                                <th>Mã giao dịch</th>
                                <th>Ngày thanh toán</th>
                                <th>Số tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in payments)
                            {
                                <tr>
                                    <td>@payment.pay_id</td>
                                    <td>@payment.pay_createdDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@payment.pay_price.ToString("N0") VND</td>
                                    <td>
                                        <span class="badge @(payment.pay_status == "Success" ? "bg-success" : "bg-danger")">
                                            @payment.pay_status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info text-center">Bạn chưa có giao dịch thanh toán nào.</div>
        }
    </div>
</div>
