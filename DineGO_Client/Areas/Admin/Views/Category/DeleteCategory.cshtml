@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <form method="post" asp-action="DeleteCategory" asp-controller="Category">
        <input type="hidden" name="cate_id" value="@Model.cate_id" />

        <div class="mb-3">
            <label class="form-label">Category ID</label>
            <input type="text" class="form-control" value="@Model.cate_id" readonly>
        </div>

        <div class="mb-3">
            <label class="form-label">Category Type</label>
            <input type="text" class="form-control" value="@Model.cate_type" readonly>
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" rows="3" readonly>@Model.cate_description</textarea>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <button type="submit" class="btn btn-danger">Delete Category</button>
            <a asp-action="Index" asp-controller="Category" asp-area="Admin" class="btn btn-secondary">Back</a>
        </div>
    </form>

</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}