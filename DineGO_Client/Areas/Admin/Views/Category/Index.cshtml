@model List<DineGO_Client.Model.Category>

@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Category";
}

<table class="table align-middle mb-0 bg-white shadow-lg">
    <thead class="bg-light">
        <tr>
            <th>Type</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
               
                <td>
                    <p class="fw-normal mb-1">@category.cate_type</p>
                </td>
                <td class="description">
                    @category.cate_description
                </td>
                <td>
                    <a href="/Admin/Category/AddCategory" class="btn btn-link btn-sm btn-rounded">
                        <i class="fas fa-plus"></i>
                    </a>
                    <a href="/Admin/Category/UpdateCategory" class="btn btn-link btn-sm btn-rounded">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a href="/Admin/Category/DeleteCategory" class="btn btn-link btn-sm btn-rounded">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
