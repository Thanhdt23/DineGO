@model DineGO_Client.Model.Category

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Category";
}

<div class="container">
    <div class="form-container">
        <h2 class="text-center mb-4">Add Category</h2>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }
        <form asp-area="Admin" asp-action="Add" method="post">
            <input type="hidden" asp-for="cate_id" />
            <div class="form-group">
                <label asp-for="cate_type" class="form-label">Category Type</label>
                <input asp-for="cate_type" class="form-control" placeholder="Enter category type" required />
                <span asp-validation-for="cate_type" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="cate_description" class="form-label">Description</label>
                <textarea asp-for="cate_description" class="form-control" rows="3" placeholder="Enter category description"></textarea>
                <span asp-validation-for="cate_description" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Add Category</button>
            <a href="@Url.Action("Index", "Category", new { area = "Admin" })" class="btn btn-secondary btn-block mb-3">Back</a>
        </form>
    </div>
</div>