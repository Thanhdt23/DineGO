@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Reservation";
}
<h2>Quản lí đơn đặt bàn</h2>
<table class="table align-middle mb-0 bg-white shadow-lg">
    <thead class="bg-light">
        <tr>
            <th>Mã Đặt Chỗ</th>
            <th>Nhà Hàng</th>
            <th>Khách Hàng</th>
            <th>Trạng Thái</th>
            <th>Số Lượng</th>
            <th>Ngày và Giờ</th>
            <th>Ghi Chú</th>
            @* <th>Actions</th> *@
        </tr>
    </thead>
    <tbody>
        @foreach (var reservation in Model)
        {
            <tr>
                <td>
                    <p class="fw-bold mb-1">@reservation.reser_id</p>
                </td>
                <td>
                    <p class="fw-bold mb-1">@reservation.restaurant.res_name</p>
                </td>
                <td>
                    <p class="fw-bold mb-1">@reservation.customer.cus_name</p>
                </td>
                <td>
                    <span class="badge @(reservation.reser_status == "Booked" ? "badge-success" : "badge-warning") rounded-pill d-inline">
                        @reservation.reser_status
                    </span>
                </td>
                <td>
                    <p class="fw-bold mb-1">@reservation.reser_quantity</p>
                </td>
                <td>
                    <p class="fw-normal mb-1">@reservation.reser_date.ToString("yyyy-MM-dd HH:mm")</p>
                </td>
                <td class="description">
                    @reservation.reser_note
                </td>
                @* <td>
                    <a href="@Url.Action("ViewReservation", "Reservation", new { id = reservation.reser_id })" class="btn btn-link btn-sm btn-rounded">
                        <i class="fas fa-plus"></i>
                    </a>
                    <a href="@Url.Action("EditReservation", "Reservation", new { id = reservation.reser_id })" class="btn btn-link btn-sm btn-rounded">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a href="@Url.Action("DeleteReservation", "Reservation", new { id = reservation.reser_id })" class="btn btn-link btn-sm btn-rounded">
                        <i class="fas fa-trash"></i>
                    </a>
                </td> *@
            </tr>
        }
    </tbody>
</table>
