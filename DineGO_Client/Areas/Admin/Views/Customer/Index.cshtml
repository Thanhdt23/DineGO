@model List<DineGO_Client.Model.Customer>
@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Customer";
}

<table class="table align-middle mb-0 bg-white shadow-lg">
    <thead class="bg-light">
        <tr>
            <th>Image</th>
            <th>Customer ID</th>
            <th>Username</th>
            <th>Password</th>
            <th>Name</th>
            <th>Birthday</th>
            <th>Gender</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Address</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>
                    <img src="@customer.cus_image" alt="Customer Image" style="width: 50px; height: 50px; border-radius: 50%;">
                </td>
                <td>
                    <p class="fw-bold mb-1">@customer.cus_id</p>
                </td>
                <td>
                    <p class="fw-normal mb-1">@customer.cus_username</p>
                </td>
                <td>
                    <p class="fw-normal mb-1">********</p> 
                </td>
                <td>
                    <p class="fw-normal mb-1">@customer.cus_name</p>
                </td>
                <td>
                    <p class="fw-normal mb-1">@customer.cus_birthday.ToString("yyyy-MM-dd")</p>
                </td>
                <td>
                    <p class="fw-normal mb-1">@customer.cus_gender</p>
                </td>
                <td>
                    <p class="fw-normal mb-1">@customer.cus_phone</p>
                </td>
                <td>
                    <p class="fw-normal mb-1">@customer.cus_email</p>
                </td>
                <td>
                    <p class="fw-normal mb-1">@customer.cus_address</p>
                </td>
                <td>
                    <button type="button" class="btn btn-link btn-sm btn-rounded">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button type="button" class="btn btn-link btn-sm btn-rounded">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
