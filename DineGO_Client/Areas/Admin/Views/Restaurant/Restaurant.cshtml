@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Restaurant";
}
<table class="table align-middle mb-0 bg-white shadow-lg">
    <thead class="bg-light">
        <tr>
            <th>Image</th>
            <th>Restaurant ID</th>
            <th>Information</th>
            <th>Address</th>
            <th>Price</th>
            <th>Discount</th>
            <th>Phone</th>
            <th>Rate</th>
            <th>Category</th>
            <th>Owner</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var restaurant in Model)
        {
            <tr>
                <td>
                    <img width="50px" height="50px" src="@(restaurant.res_images != null && restaurant.res_images.Count > 0 ? Url.Content("~/client/images/" + restaurant.res_images[0]) : Url.Content("~/common/images/banner.jpg"))"
     alt="Restaurant Image" class="restaurant-image">
                </td>
                <td>@restaurant.res_id</td>
                <td>@restaurant.res_information</td>
                <td>@restaurant.res_address</td>
                <td>$@restaurant.res_price</td>
                <td>@restaurant.res_discount%</td>
                <td>@restaurant.res_phone</td>
                <td>@restaurant.res_rate</td>
                <td>@restaurant.category</td>
            </tr>
        }
    </tbody>
</table>
