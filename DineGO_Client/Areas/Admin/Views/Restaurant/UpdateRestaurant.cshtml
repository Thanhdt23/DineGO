@model DineGO_Client.Model.Restaurant

@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Update Restaurant";
}

<form asp-action="UpdateRestaurant" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="res_id" />
    <input type="hidden" asp-for="cate_id" />
    <input type="hidden" asp-for="resOwner_id" />

    <div class="mb-3">
        <label asp-for="res_name" class="form-label">Name</label>
        <input type="text" class="form-control" asp-for="res_name" required>
    </div>

    <div class="mb-3"> 
        <label asp-for="res_information" class="form-label">Information</label>
        <textarea class="form-control" asp-for="res_information" rows="3"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Current Image</label>
        <img src="@(Model.res_images?.FirstOrDefault() ?? "default.jpg")" class="img-fluid mb-2" style="width: 100px; height: 100px; object-fit: cover;">
        <input type="file" class="form-control" name="image">
    </div>

    <div class="mb-3">
        <label asp-for="res_address" class="form-label">Address</label>
        <input type="text" class="form-control" asp-for="res_address">
    </div>

    <div class="mb-3">
        <label asp-for="res_phone" class="form-label">Phone</label>
        <input type="text" class="form-control" asp-for="res_phone">
    </div>

    <div class="mb-3">
        <label asp-for="res_price" class="form-label">Price</label>
        <input type="number" class="form-control" asp-for="res_price" step="0.01">
    </div>

    <div class="mb-3">
        <label asp-for="res_discount" class="form-label">Discount</label>
        <input type="number" class="form-control" asp-for="res_discount" step="0.01">
    </div>

    <div class="mb-3">
        <label asp-for="res_rate" class="form-label">Rate</label>
        <input type="number" class="form-control" asp-for="res_rate" step="0.1" max="5">
    </div>

    <div class="d-flex justify-content-between">
        <button type="submit" class="btn btn-primary">Update Restaurant</button>
        <a href="javascript:history.back()" class="btn btn-secondary">Back</a>
    </div>
</form>