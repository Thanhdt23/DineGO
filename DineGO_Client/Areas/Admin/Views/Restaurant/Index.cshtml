@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Restaurant";
}

@model List<DineGO_Client.Model.Restaurant>

<table class="table align-middle mb-0 bg-white shadow-lg">
    <thead class="bg-light">
        <tr>
            <th>Image</th>
            <th>Restaurant ID</th>
            <th>Information</th>
            <th>Address</th>
            <th>Type</th>
            <th>Price</th>
            <th>Discount</th>
            <th>Phone</th>
            <th>Rate</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var restaurant in Model)
        {
            <tr>
                <td>
                    <img src="@(restaurant.res_images.FirstOrDefault() ?? "default.jpg")" class="img-fluid" style="width: 80px; height: 80px; object-fit: cover;" alt="Restaurant Image">
                </td>
                <td>
                    <p class="fw-bold mb-1">@restaurant.res_id</p>
                </td>
                <td>
                    @restaurant.res_information
                </td>
                <td>
                    @restaurant.res_address
                </td>
                <td>
                    <span class="badge badge-primary rounded-pill d-inline">@restaurant.res_type</span>
                </td>
                <td>
                    <p class="fw-bold mb-1">$@restaurant.res_price</p>
                </td>
                <td>
                    <p class="fw-bold mb-1">@restaurant.res_discount%</p>
                </td>
                <td>
                    <p class="fw-normal mb-1">@restaurant.res_phone</p>
                </td>
                <td>
                    <span class="badge badge-warning rounded-pill d-inline">@restaurant.res_rate</span>
                </td>
                <td>
                    <button type="button" class="btn btn-link btn-sm btn-rounded">
                        <i class="fas fa-plus"></i>
                    </button>
                    <button type="button" class="btn btn-link btn-sm btn-rounded">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button type="button" class="btn btn-link btn-sm btn-rounded">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
