@model List<DineGO_Client.Model.RestaurantOwner>

@{
    ViewData["Title"] = "Index";
    Layout = "../../Views/Shared/_Layout.cshtml";
}

<h2>Restaurant Owners</h2>

<table class="table align-middle mb-0 bg-white shadow-lg">
    <thead class="bg-light">
        <tr>
            <th>Owner ID</th>
            <th>Name</th>
            <th>Create Date</th>
            <th>Is Authorize</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var owner in Model)
        {
            <tr>
                <td>@owner.resOwner_id</td>
                <td>@owner.resOwner_name</td>
                <td>@owner.resOwner_createdDate</td>
                <td>
                    <form method="post" asp-action="EditAuthorize" class="d-inline">
                        <input type="hidden" name="resOwner_id" value="@owner.resOwner_id" />

                        <select name="resOwner_isAuthorize" class="form-control d-inline w-auto">
                            <option value="true" selected="@(owner.resOwner_isAuthorize ? "selected" : "")">True</option>
                            <option value="false" selected="@(!owner.resOwner_isAuthorize ? "selected" : "")">False</option>

                        </select>


                        <button type="submit" class="btn btn-warning btn-sm">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                    </form>
                </td>
                <td>
                    <form asp-action="Delete" asp-route-id="@owner.resOwner_id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?');">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary mt-3">
    <i class="fas fa-plus"></i> Add New Owner
</a>
