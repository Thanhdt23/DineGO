@model List<DineGO_Client.Model.RestaurantOwner>
@{
    ViewData["Title"] = "Index";
    Layout = "../../Views/Shared/_Layout.cshtml";
}

<h2>Restaurant Owners</h2>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Customer ID</th>
            <th>Name</th>
            <th>Created Date</th>
            <th>Authorized</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var owner in Model)
        {
            <tr>
                <td>@owner.resOwner_id</td>
                <td>@owner.cus_id</td>
                <td>@owner.resOwner_name</td>
                <td>@owner.resOwner_createdDate.ToString("yyyy-MM-dd")</td>
                <td>@(owner.resOwner_isAuthorize ? "Yes" : "No")</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = owner.resOwner_id })">Edit</a>

                    <form asp-action="Delete" method="post" style="display:inline;"
                        onsubmit="return confirm('Are you sure you want to delete this owner?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@owner.resOwner_id" />
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>


                </td>
            </tr>
        }
    </tbody>
</table>

<a href="@Url.Action("Create")" class="btn btn-primary">Add New Owner</a>
