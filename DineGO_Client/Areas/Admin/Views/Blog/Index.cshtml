@model List<DineGO_Client.Model.Blog>

@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Blog";
}
<h2>Quản lí bài viết</h2>
@* <a href="@Url.Action("AddBlog", "Blog")" class="btn btn-link btn-sm btn-rounded text-success">
    <i class="fas fa-plus"></i>
</a> *@
<table class="table align-middle mb-0 bg-white shadow-lg">
    <thead class="bg-light">
        <tr>
            <th>Hình ảnh</th>
            <th>Mã Blog</th>
            <th>Ngày</th>
            <th>Thông tin</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var blog in Model)
        {
            <tr>
                <td>
                    <img src="@blog.blog_image" alt="@blog.blog_title" style="width: 80px; height: 80px; object-fit: cover;">
                </td>
                <td>
                    <p class="fw-bold mb-1">@blog.blog_id</p>
                </td>
                <td>
                    <p class="fw-normal mb-1">@blog.blog_date.ToString("yyyy-MM-dd")</p>
                </td>
                <td>
                    @blog.blog_information
                </td>
                @* <td>
                    <a href="@Url.Action("EditBlog", "Blog", new { id = blog.blog_id })" class="btn btn-link btn-sm btn-rounded">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a href="@Url.Action("DeleteBlog", "Blog", new { id = blog.blog_id })" class="btn btn-link btn-sm btn-rounded text-danger">
                        <i class="fas fa-trash"></i>
                    </a>
                </td> *@
            </tr>
        }
    </tbody>
</table>
