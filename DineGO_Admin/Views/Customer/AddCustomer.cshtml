@model DineGO_Admin.Model.Customer
@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Customer";
}

<div class="container">
    <div class="form-container">
        <h2 class="text-center mb-4">@ViewData["Title"]</h2>
        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form asp-action="AddCustomer" method="post" enctype="multipart/form-data">
          <input type="hidden" name="cus_id" />

            <div class="form-group">
                <label asp-for="cus_name"></label>
                <input asp-for="cus_name" class="form-control" placeholder="Enter customer name">
                <span asp-validation-for="cus_name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="cus_username"></label>
                <input asp-for="cus_username" class="form-control" placeholder="Enter username">
                <span asp-validation-for="cus_username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="cus_password"></label>
                <input asp-for="cus_password" type="password" class="form-control" placeholder="Enter password">
                <span asp-validation-for="cus_password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="cus_birthday"></label>
                <input asp-for="cus_birthday" type="date" class="form-control">
                <span asp-validation-for="cus_birthday" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="cus_gender"></label>
                <select asp-for="cus_gender" class="form-control">
                    <option value="">Select gender</option>
                    <option value="male">Male</option>
                    <option value="female">Female</option>
                    <option value="other">Other</option>
                </select>
                <span asp-validation-for="cus_gender" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="cus_image">Profile Image</label>
                <input type="file" name="imageFile" class="form-control-file" accept="image/*">
            </div>

            <div class="form-group">
                <label asp-for="cus_phone"></label>
                <input asp-for="cus_phone" class="form-control" placeholder="Enter phone number">
                <span asp-validation-for="cus_phone" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="cus_email"></label>
                <input asp-for="cus_email" type="email" class="form-control" placeholder="Enter email address">
                <span asp-validation-for="cus_email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="cus_address"></label>
                <input asp-for="cus_address" class="form-control" placeholder="Enter address">
                <span asp-validation-for="cus_address" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Add Customer</button>
            <a asp-action="Index" class="btn btn-secondary btn-block mb-3">Back</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}