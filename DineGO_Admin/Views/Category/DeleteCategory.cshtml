@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Xóa Danh Mục";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <form method="post" asp-action="DeleteCategory" asp-controller="Category">
        <input type="hidden" name="cate_id" value="@Model.cate_id" />

        <div class="mb-3">
            <label class="form-label">Mã Danh Mục</label>
            <input type="text" class="form-control" value="@Model.cate_id" readonly>
        </div>

        <div class="mb-3">
            <label class="form-label">Loại Danh Mục</label>
            <input type="text" class="form-control" value="@Model.cate_type" readonly>
        </div>

        <div class="mb-3">
            <label class="form-label">Mô Tả</label>
            <textarea class="form-control" rows="3" readonly>@Model.cate_description</textarea>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <button type="submit" class="btn btn-danger">Xóa Danh Mục</button>
           <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>

</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}