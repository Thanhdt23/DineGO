@{
    ViewData["Title"] = "Thêm Danh Mục";
    Layout = "../../Views/Shared/_Layout.cshtml";
}

<h2>Thêm Danh Mục Mới</h2>

<form asp-action="AddCategory" method="post">
    <div class="form-group">
        <label for="cate_type">Loại Danh Mục</label>
        <input type="text" id="cate_type" name="cate_type" class="form-control" required>
    </div>

    <div class="form-group">
        <label for="cate_description">Mô Tả</label>
        <textarea id="cate_description" name="cate_description" class="form-control" rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Thêm</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy</a>
</form>
