@model List<DineGO_Admin.Model.Category>

@{
    Layout = "../../Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Category";
}
<h2>Quản lí danh mục</h2>
<table class="table align-middle mb-0 bg-white shadow-lg">
    <thead class="bg-light">      
            <!-- Loại bỏ Category ID -->
            <th>Loại</th>
            <th>Mô tả</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        <a href="@Url.Action("AddCategory", "Category")" class="btn btn-link btn-sm btn-rounded text-success">
                        <i class="fas fa-plus"></i>
                    </a>  
        @foreach (var category in Model)
        {
            <tr>
                <!-- Không hiển thị cate_id -->
                <td>
                    <p class="fw-normal mb-1">@category.cate_type</p>
                </td>
                <td class="description">
                    @category.cate_description
                </td>
                <td>            
                    <a href="@Url.Action("UpdateCategory", "Category", new { id = category.cate_id })" class="btn btn-link btn-sm btn-rounded">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a href="@Url.Action("DeleteCategory", "Category", new { id = category.cate_id })" class="btn btn-link btn-sm btn-rounded text-danger">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
            </tr>
        }

    </tbody>
</table>
